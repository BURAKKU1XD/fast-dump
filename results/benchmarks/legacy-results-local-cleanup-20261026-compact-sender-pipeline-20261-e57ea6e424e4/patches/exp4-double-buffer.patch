+    #[test]
+    fn source_overlaps_consumer_with_exactly_two_buffers_and_no_slice_copy() {
+        struct Reader {
+            reads: Arc<AtomicUsize>,
+            pointers: Arc<Mutex<HashSet<usize>>>,
+            second: Sender<()>,
+        }
+        impl Read for Reader {
+            fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+                let index = self.reads.load(Ordering::SeqCst);
+                if index == 3 {
+                    return Ok(0);
+                }
+                assert_eq!(bytes.len(), STREAM_READ_BYTES);
+                self.pointers
+                    .lock()
+                    .unwrap()
+                    .insert(bytes.as_ptr() as usize);
+                bytes.fill(index as u8);
+                self.reads.fetch_add(1, Ordering::SeqCst);
+                if index == 1 {
+                    self.second.send(()).unwrap();
+                }
+                Ok(bytes.len())
+            }
+        }
+        struct Writer {
+            reads: Arc<AtomicUsize>,
+            pointers: Arc<Mutex<HashSet<usize>>>,
+            second: Receiver<()>,
+            writes: usize,
+        }
+        impl Write for Writer {
+            fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+                if self.writes == 0 {
+                    self.second.recv_timeout(TIMEOUT).unwrap();
+                    // Пока первый slice у consumer, второй уже прочитан, но
+                    // третьему нет свободного буфера независимо от скорости CPU.
+                    assert_eq!(self.reads.load(Ordering::SeqCst), 2);
+                }
+                assert!(
+                    self.pointers
+                        .lock()
+                        .unwrap()
+                        .contains(&(bytes.as_ptr() as usize))
+                );
+                assert!(bytes.iter().all(|&byte| byte == self.writes as u8));
+                self.writes += 1;
+                Ok(bytes.len())
+            }
+            fn flush(&mut self) -> io::Result<()> {
+                Ok(())
+            }
+        }
+        let reads = Arc::new(AtomicUsize::new(0));
+        let pointers = Arc::new(Mutex::new(HashSet::new()));
+        let (second_tx, second_rx) = bounded(1);
+        let mut reader = Reader {
+            reads: reads.clone(),
+            pointers: pointers.clone(),
+            second: second_tx,
+        };
+        let mut writer = Writer {
+            reads,
+            pointers: pointers.clone(),
+            second: second_rx,
+            writes: 0,
+        };
+        let workspace = SourceWorkspace::default();
+        let cancelled = AtomicBool::new(false);
+        let (result, _) = with_source_reader(
+            &mut reader,
+            &workspace,
+            cancellation(&cancelled),
+            |chunks| chunks.copy_into(&mut writer, "fixture", None),
+        )
+        .unwrap();
+        result.unwrap();
+        assert_eq!(writer.writes, 3);
+        assert_eq!(pointers.lock().unwrap().len(), SOURCE_BUFFERS);
+        assert_eq!(workspace.pointers().len(), SOURCE_BUFFERS);
+    }
+
