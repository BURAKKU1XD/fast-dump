@@ -0,0 +1,348 @@
+use std::io::{self, Read, Write};
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use anyhow::{Context, Result};
+use crossbeam_channel::{Receiver, Sender, bounded};
+
+use super::{AttemptCancellation, consumer_disconnected};
+use crate::progress::{self, PipelineStage, PipelineState, SourceFileGuard};
+use crate::sender::tar::{STREAM_READ_BYTES, write_source_payload};
+
+const SOURCE_BUFFERS: usize = 2;
+
+#[derive(Default)]
+pub(super) struct SourceWorkspace {
+    buffers: Arc<Mutex<Vec<Vec<u8>>>>,
+}
+
+impl SourceWorkspace {
+    fn take_buffer(&self) -> SourceBuffer {
+        let bytes = self
+            .buffers
+            .lock()
+            .unwrap_or_else(|error| error.into_inner())
+            .pop()
+            .unwrap_or_else(|| vec![0; STREAM_READ_BYTES]);
+        SourceBuffer {
+            bytes,
+            pool: self.buffers.clone(),
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn pointers(&self) -> Vec<usize> {
+        let buffers = self.buffers.lock().unwrap();
+        let mut pointers = buffers
+            .iter()
+            .map(|buffer| {
+                assert_eq!(buffer.len(), STREAM_READ_BYTES);
+                buffer.as_ptr() as usize
+            })
+            .collect::<Vec<_>>();
+        pointers.sort_unstable();
+        pointers
+    }
+}
+
+struct SourceBuffer {
+    bytes: Vec<u8>,
+    pool: Arc<Mutex<Vec<Vec<u8>>>>,
+}
+
+impl Drop for SourceBuffer {
+    fn drop(&mut self) {
+        // Длину сохраняем: следующая попытка не обнуляет уже готовые 1 MiB.
+        self.pool
+            .lock()
+            .unwrap_or_else(|error| error.into_inner())
+            .push(std::mem::take(&mut self.bytes));
+    }
+}
+
+struct SourceChunk {
+    buffer: SourceBuffer,
+    len: usize,
+}
+
+pub(super) struct SourceChunks<'a> {
+    ready: Receiver<io::Result<SourceChunk>>,
+    recycle: Sender<SourceBuffer>,
+    cancelled: AttemptCancellation<'a>,
+    wait_duration: Duration,
+}
+
+impl SourceChunks<'_> {
+    pub(super) fn copy_into(
+        &mut self,
+        writer: &mut impl Write,
+        relative_path: &str,
+        progress: Option<&SourceFileGuard<'_>>,
+    ) -> Result<()> {
+        loop {
+            self.cancelled.check()?;
+            let waiting = Instant::now();
+            let wait = progress::stage(
+                self.cancelled.control,
+                PipelineStage::Compress,
+                PipelineState::WaitingRead,
+            );
+            let next = self.ready.recv();
+            self.wait_duration += waiting.elapsed();
+            drop(wait);
+            let chunk = match next {
+                Ok(chunk) => chunk.with_context(|| {
+                    format!("failed to read streamed v4 tar payload for {relative_path}")
+                })?,
+                Err(_) => return Ok(()),
+            };
+            // Zstd потребляет owned slice до возврата буфера; промежуточной копии нет.
+            write_source_payload(writer, &chunk.buffer.bytes[..chunk.len], progress).with_context(
+                || format!("failed to write streamed v4 tar payload for {relative_path}"),
+            )?;
+            let _ = self.recycle.try_send(chunk.buffer);
+        }
+    }
+}
+
+pub(super) fn with_source_reader<R: Read + Send, T>(
+    reader: &mut R,
+    workspace: &SourceWorkspace,
+    cancelled: AttemptCancellation<'_>,
+    consume: impl FnOnce(&mut SourceChunks<'_>) -> Result<T>,
+) -> Result<(Result<T>, Duration)> {
+    thread::scope(|scope| {
+        let (ready_tx, ready_rx) = bounded(1);
+        let (recycle_tx, recycle_rx) = bounded(SOURCE_BUFFERS);
+        for _ in 0..SOURCE_BUFFERS {
+            recycle_tx
+                .send(workspace.take_buffer())
+                .map_err(|_| consumer_disconnected())?;
+        }
+        let worker = thread::Builder::new()
+            .name("dump-source-read".into())
+            .spawn_scoped(scope, move || {
+                read_source(reader, ready_tx, recycle_rx, cancelled);
+            })
+            .context("failed to start v4 streamed source reader")?;
+        let mut chunks = SourceChunks {
+            ready: ready_rx,
+            recycle: recycle_tx,
+            cancelled,
+            wait_duration: Duration::ZERO,
+        };
+        let result = consume(&mut chunks);
+        let mut wait_duration = chunks.wait_duration;
+        // Закрываем обе очереди до join, в том числе при ранней ошибке encoder.
+        // При panic Drop chunks происходит до автоматического scoped join.
+        drop(chunks);
+        let joining = Instant::now();
+        worker
+            .join()
+            .map_err(|_| anyhow::anyhow!("v4 streamed source reader panicked"))?;
+        wait_duration += joining.elapsed();
+        Ok((result, wait_duration))
+    })
+}
+
+fn read_source(
+    reader: &mut impl Read,
+    ready: Sender<io::Result<SourceChunk>>,
+    recycle: Receiver<SourceBuffer>,
+    cancelled: AttemptCancellation<'_>,
+) {
+    while let Ok(mut buffer) = recycle.recv() {
+        let read = loop {
+            if let Err(error) = cancelled.check() {
+                break Err(io::Error::other(error));
+            }
+            match reader.read(&mut buffer.bytes) {
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                result => break result,
+            }
+        };
+        match read {
+            Ok(0) => return,
+            Ok(len) => {
+                if ready.send(Ok(SourceChunk { buffer, len })).is_err() {
+                    return;
+                }
+            }
+            Err(error) => {
+                // Ошибка следует за уже прочитанными slices: успешный префикс
+                // проходит тот же учёт, а незавершённый zstd frame не финализируется.
+                let _ = ready.send(Err(error));
+                return;
+            }
+        }
+    }
+}
+
