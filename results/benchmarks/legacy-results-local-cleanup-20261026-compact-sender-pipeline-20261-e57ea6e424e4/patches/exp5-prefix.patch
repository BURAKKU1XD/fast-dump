+        let dir = TestDir::new();
+        const MEDIUM_BYTES: usize = 8 * 1024 * 1024 + 17;
+        for index in 0..65 {
+            let size = if index == 0 || index == 32 {
+                MEDIUM_BYTES
+            } else {
+                17
+            };
+            fs::write(
+                dir.path().join(format!("{index:03}")),
+                vec![index as u8; size],
+            )
+            .unwrap();
+        }
+        let scan = scan_source_tree(dir.path()).unwrap();
+        let mut reader = OrderedReader::new(scan.entries, 2, 16 * 1024 * 1024).unwrap();
+        for index in 0..65 {
+            let Some(ReadDecision::Accepted(entry)) = reader.next().unwrap() else {
+                panic!("ordered prefix result was not materialized");
+            };
+            assert_eq!(entry.descriptor.work_ordinal, index + 1);
+            assert_eq!(entry.descriptor.relative_path, format!("{index:03}"));
+            let prefixed = index == 0 || index == 32;
+            assert_eq!(
+                entry.contents.len(),
+                if prefixed { MEDIUM_BYTES } else { 17 }
+            );
+            assert_eq!(
+                entry.contents.segments().count(),
+                if prefixed { 2 } else { 1 }
+            );
+            for segment in entry.contents.segments() {
+                assert!(segment.iter().all(|&byte| byte == index as u8));
+            }
+        }
+        assert!(reader.next().unwrap().is_none());
+    }
