+#[cfg(windows)]
+fn narrow_regular_metadata(file: &File) -> io::Result<RegularMetadata> {
+    use std::os::windows::io::AsRawHandle;
+    use windows_sys::Win32::Storage::FileSystem::{
+        FILE_ATTRIBUTE_TAG_INFO, FILE_STANDARD_INFO, FileAttributeTagInfo, FileStandardInfo,
+        GetFileInformationByHandleEx,
+    };
+    let mut attributes = FILE_ATTRIBUTE_TAG_INFO::default();
+    let mut standard = FILE_STANDARD_INFO::default();
+    // Каждый запрос заполняет ровно соответствующую C-структуру живого handle.
+    // Это эксперимент с ценой узких запросов, а не сокращение числа syscalls.
+    let attributes_ok = unsafe {
+        GetFileInformationByHandleEx(
+            file.as_raw_handle(),
+            FileAttributeTagInfo,
+            (&mut attributes as *mut FILE_ATTRIBUTE_TAG_INFO).cast(),
+            std::mem::size_of::<FILE_ATTRIBUTE_TAG_INFO>() as u32,
+        )
+    };
+    if attributes_ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let standard_ok = unsafe {
+        GetFileInformationByHandleEx(
+            file.as_raw_handle(),
+            FileStandardInfo,
+            (&mut standard as *mut FILE_STANDARD_INFO).cast(),
+            std::mem::size_of::<FILE_STANDARD_INFO>() as u32,
+        )
+    };
+    if standard_ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    decode_regular_metadata(attributes, standard)
+}
+
+#[cfg(windows)]
+fn decode_regular_metadata(
+    attributes: windows_sys::Win32::Storage::FileSystem::FILE_ATTRIBUTE_TAG_INFO,
+    standard: windows_sys::Win32::Storage::FileSystem::FILE_STANDARD_INFO,
+) -> io::Result<RegularMetadata> {
+    use windows_sys::Win32::Storage::FileSystem::{
+        FILE_ATTRIBUTE_DIRECTORY, FILE_ATTRIBUTE_READONLY, FILE_ATTRIBUTE_REPARSE_POINT,
+    };
+    // Как std: все name-surrogate tags являются ссылками, не только SYMLINK.
+    let name_surrogate = attributes.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT != 0
+        && attributes.ReparseTag & 0x2000_0000 != 0;
+    if standard.Directory
+        || attributes.FileAttributes & FILE_ATTRIBUTE_DIRECTORY != 0
+        || name_surrogate
+        || standard.EndOfFile < 0
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "source entry is no longer a regular file",
+        ));
+    }
+    Ok(RegularMetadata {
+        // AllocationSize включает особенности размещения и не задаёт длину чтения.
+        size: standard.EndOfFile as u64,
+        mode: if attributes.FileAttributes & FILE_ATTRIBUTE_READONLY != 0 {
+            0o444
+        } else {
+            0o644
+        },
+        attributes: attributes.FileAttributes,
+    })
 }
 
