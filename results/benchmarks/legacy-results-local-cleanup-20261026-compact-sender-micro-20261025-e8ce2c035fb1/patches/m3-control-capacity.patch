+    last_path_bytes: usize,
+) -> usize {
+    // Общая формула для planner и encoder: attempt_no, поля bundle и повтор последнего пути.
+    BUNDLE_PLAN_FIXED_BODY_BYTES
+        .saturating_add(last_path_bytes)
+        .saturating_add(entry_descriptor_bytes)
+}
 
