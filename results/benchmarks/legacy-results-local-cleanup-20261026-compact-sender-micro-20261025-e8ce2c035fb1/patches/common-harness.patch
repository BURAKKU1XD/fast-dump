+//! Измерение production control encoding без сокетов и подготовки descriptor в таймере.
+
+use std::hint::black_box;
+use std::io::Cursor;
+
+use anyhow::{Context, Result, bail, ensure};
+use xxhash_rust::xxh3::xxh3_64;
+
+use super::protocol::{
+    BundleCommitDescriptor, BundleEntryDescriptor, BundleEntryKind, BundlePlanDescriptor, wire,
+};
+use crate::sender::file_bench::{AllocationHooks, Measurement, measure_cpu_work};
+
+pub const CASES: [&str; 8] = [
+    "plan-short-1",
+    "plan-short-256",
+    "plan-short-4096",
+    "plan-long-1",
+    "plan-long-256",
+    "plan-long-4096",
+    "commit",
+    "noop",
+];
+
+pub struct ControlMeasurement {
+    pub counters: Measurement,
+    pub entries: usize,
+    pub symlinks: usize,
+    pub packet_bytes: usize,
+    pub body_bytes: usize,
+    pub fingerprint: u64,
+}
+
+fn fixture(case: &str) -> Result<Option<wire::Message>> {
+    if case == "noop" {
+        return Ok(None);
+    }
+    if case == "commit" {
+        return Ok(Some(wire::Message::BundleCommit(wire::BundleCommit {
+            attempt_no: 3,
+            descriptor: BundleCommitDescriptor {
+                bundle_no: 7,
+                tar_payload_bytes: 64 * 1024 * 1024,
+                compressed_payload_bytes: 123_456,
+                compressed_xxh3_64: 0x1234_5678_9abc_def0,
+            },
+        })));
+    }
+    ensure!(
+        CASES.contains(&case),
+        "unknown control benchmark case: {case}"
+    );
+    let (_, count) = case.rsplit_once('-').context("case has no entry count")?;
+    let count = count.parse::<usize>()?;
+    let long = case.starts_with("plan-long-");
+    let prefix = "длинный-каталог/".repeat(8);
+    let mut entries = Vec::with_capacity(count);
+    let mut raw_payload_bytes = 0;
+    for index in 0..count {
+        let relative_path = if long {
+            format!("{prefix}файл-{index:04}-😀.bin")
+        } else {
+            format!("dir/file-{index:04}.bin")
+        };
+        let symlink = index.is_multiple_of(8);
+        let size_at_open = if symlink { 0 } else { 1024 + index as u64 };
+        raw_payload_bytes += size_at_open;
+        entries.push(BundleEntryDescriptor {
+            work_ordinal: index as u64 + 1,
+            relative_path,
+            kind: if symlink {
+                BundleEntryKind::Symlink {
+                    target: if long {
+                        format!("../{prefix}цель-{index:04}-😀.bin")
+                    } else {
+                        format!("../target-{index:04}.bin")
+                    },
+                }
+            } else {
+                BundleEntryKind::Regular
+            },
+            size_at_open,
+            best_effort: false,
+        });
+    }
+    Ok(Some(wire::Message::BundlePlan(wire::BundlePlan {
+        attempt_no: 3,
+        descriptor: BundlePlanDescriptor {
+            bundle_no: 7,
+            first_work_ordinal: 1,
+            last_work_ordinal: count as u64,
+            last_relative_path: entries.last().unwrap().relative_path.clone(),
+            entries,
+            raw_payload_bytes,
+        },
+    })))
+}
+
+fn expected_layout(message: &wire::Message) -> Result<(usize, usize, usize)> {
+    match message {
+        wire::Message::BundleCommit(_) => Ok((0, 0, 36)),
+        wire::Message::BundlePlan(plan) => {
+            let descriptor = &plan.descriptor;
+            let mut body_bytes = 44 + descriptor.last_relative_path.len();
+            let mut symlinks = 0;
+            for entry in &descriptor.entries {
+                body_bytes += 22 + entry.relative_path.len();
+                if let BundleEntryKind::Symlink { target } = &entry.kind {
+                    body_bytes += 4 + target.len();
+                    symlinks += 1;
+                }
+            }
+            Ok((descriptor.entries.len(), symlinks, body_bytes))
+        }
+        _ => bail!("unexpected benchmark message"),
+    }
+}
+
+pub fn measure(
+    case: &str,
+    iterations: u64,
+    hooks: Option<AllocationHooks>,
+) -> Result<ControlMeasurement> {
+    ensure!(iterations > 0, "iterations must be positive");
+    let message = fixture(case)?;
+    let mut expected = Vec::new();
+    let (entries, symlinks, body_bytes) = if let Some(message) = &message {
+        wire::write_message(&mut expected, message)?;
+        let layout = expected_layout(message)?;
+        ensure!(
+            layout.2 <= wire::MAX_CONTROL_BODY_BYTES,
+            "fixture exceeds control body limit"
+        );
+        ensure!(
+            expected.len() == 12 + layout.2,
+            "unexpected encoded packet length"
+        );
+        let mut input = Cursor::new(expected.as_slice());
+        ensure!(
+            wire::read_message(&mut input)? == *message,
+            "control fixture roundtrip differs"
+        );
+        ensure!(
+            input.position() as usize == expected.len(),
+            "unconsumed control bytes"
+        );
+        layout
+    } else {
+        (0, 0, 0)
+    };
+    // Sink выделяется один раз до таймера. Его clear не освобождает capacity;
+    // black_box на каждом пакете не даёт удалить записи промежуточных итераций.
+    let mut sink = Vec::with_capacity(expected.len());
+    let capacity = sink.capacity();
+    let (_, counters) = measure_cpu_work(hooks, || {
+        if let Some(message) = &message {
+            for _ in 0..iterations {
+                sink.clear();
+                wire::write_message(&mut sink, black_box(message))?;
+                black_box(sink.as_slice());
+            }
+        } else {
+            for _ in 0..iterations {
+                sink.clear();
+                black_box(sink.as_slice());
+            }
+        }
+        Ok(())
+    })?;
+    ensure!(
+        sink == expected,
+        "measured control bytes differ from validated fixture"
+    );
+    ensure!(
+        sink.capacity() == capacity,
+        "benchmark sink grew during measurement"
+    );
+    Ok(ControlMeasurement {
+        counters,
+        entries,
+        symlinks,
+        packet_bytes: expected.len(),
+        body_bytes,
+        fingerprint: xxh3_64(&expected),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_control_fixture_roundtrips_and_preserves_reused_sink() {
+        for case in CASES {
+            let result = measure(case, 3, None).unwrap();
+            if case == "commit" {
+                assert_eq!((result.body_bytes, result.packet_bytes), (36, 48));
+            } else if case == "noop" {
+                assert_eq!(result.packet_bytes, 0);
+            } else {
+                assert!(result.symlinks > 0);
+                assert!(result.body_bytes <= wire::MAX_CONTROL_BODY_BYTES);
+            }
+        }
+    }
+
+    #[test]
+    fn control_measurement_rejects_invalid_case_and_zero_iterations() {
+        assert!(measure("unknown", 1, None).is_err());
+        assert!(measure("commit", 0, None).is_err());
+    }
+}
