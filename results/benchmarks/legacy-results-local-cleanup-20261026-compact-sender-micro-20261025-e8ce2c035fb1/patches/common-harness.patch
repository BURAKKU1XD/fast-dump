+use std::io::Write;
+
+use anyhow::{Context, Result, ensure};
+use clap::Parser;
+use fast_dump::network::control_bench::{CASES, measure};
+use fast_dump::sender::file_bench::AllocationHooks;
+
+#[path = "support/run_output.rs"]
+mod run_output;
+
+#[cfg(feature = "bench-allocations")]
+#[path = "support/allocation_counter.rs"]
+mod allocation_counter;
+
+#[cfg(feature = "bench-allocations")]
+#[global_allocator]
+static ALLOCATOR: allocation_counter::CountingAllocator =
+    allocation_counter::CountingAllocator::new(std::alloc::System);
+
+#[cfg(feature = "bench-allocations")]
+fn allocation_hooks() -> AllocationHooks {
+    fn start() {
+        ALLOCATOR.start();
+    }
+    fn stop() -> fast_dump::sender::file_bench::AllocationCounts {
+        ALLOCATOR.stop()
+    }
+    AllocationHooks { start, stop }
+}
+
+#[derive(Parser)]
+#[command(about = "Measure production control encoding with prepared messages and a reusable sink")]
+struct Args {
+    #[arg(long, value_parser = CASES)]
+    case: String,
+    #[arg(long, default_value_t = 1)]
+    iterations: u64,
+    #[arg(long, default_value_t = 1)]
+    repeats: usize,
+    #[arg(long)]
+    allocations: bool,
+    #[arg(long = "bench", hide = true)]
+    _bench: bool,
+}
+
+fn optional(value: Option<u64>) -> String {
+    value.map_or_else(|| "unmeasured".to_owned(), |value| value.to_string())
+}
+
+fn main() -> Result<()> {
+    let args = Args::parse();
+    ensure!(args.repeats > 0, "repeats must be positive");
+    ensure!(args.iterations > 0, "iterations must be positive");
+    let hooks: Option<AllocationHooks> = if args.allocations {
+        #[cfg(feature = "bench-allocations")]
+        {
+            Some(allocation_hooks())
+        }
+        #[cfg(not(feature = "bench-allocations"))]
+        {
+            anyhow::bail!("--allocations requires a separate --features bench-allocations build")
+        }
+    } else {
+        None
+    };
+    let output = run_output::create_run_dir("control-messages")?;
+    let mut log = std::fs::File::create(output.join("run.log"))?;
+    for repeat in 1..=args.repeats {
+        let result = measure(&args.case, args.iterations, hooks)?;
+        let counters = result.counters;
+        let entries = (result.entries as u64)
+            .checked_mul(args.iterations)
+            .context("entry count overflow")?;
+        let bytes = (result.packet_bytes as u64)
+            .checked_mul(args.iterations)
+            .context("packet byte count overflow")?;
+        let line = format!(
+            "[control-perf] stage=control case={} repeat={} iterations={} entries={} bytes={} entries_per_message={} symlinks_per_message={} packet_bytes={} body_bytes={} fingerprint={:016x} elapsed_ns={} cpu_ns={} user_ns={} kernel_ns={} cpu_cycles={} cycle_source={} io_source=unmeasured process_peak_rss_bytes={} allocs={} alloc_bytes={} reallocs={} deallocs={} alloc_successes={} alloc_success_bytes={} realloc_successes={} realloc_success_bytes={} alloc_failures={} realloc_failures={} dealloc_bytes={} zeroed_bytes={} counters_schema=2 scope=control_encode_process interval=iterations_only allocator_instrumented={} allocations_enabled={} verified=true",
+            args.case,
+            repeat,
+            args.iterations,
+            entries,
+            bytes,
+            result.entries,
+            result.symlinks,
+            result.packet_bytes,
+            result.body_bytes,
+            result.fingerprint,
+            counters.elapsed_ns,
+            counters.user_ns + counters.kernel_ns,
+            counters.user_ns,
+            counters.kernel_ns,
+            optional(counters.cpu_cycles),
+            counters.cycle_source,
+            counters.process_peak_rss_bytes,
+            optional(counters.allocations.map(|value| value.allocs)),
+            optional(counters.allocations.map(|value| value.alloc_bytes)),
+            optional(counters.allocations.map(|value| value.reallocs)),
+            optional(counters.allocations.map(|value| value.deallocs)),
+            optional(counters.allocations.map(|value| value.alloc_successes)),
+            optional(counters.allocations.map(|value| value.alloc_success_bytes)),
+            optional(counters.allocations.map(|value| value.realloc_successes)),
+            optional(
+                counters
+                    .allocations
+                    .map(|value| value.realloc_success_bytes)
+            ),
+            optional(counters.allocations.map(|value| value.alloc_failures)),
+            optional(counters.allocations.map(|value| value.realloc_failures)),
+            optional(counters.allocations.map(|value| value.dealloc_bytes)),
+            optional(counters.allocations.map(|value| value.zeroed_bytes)),
+            cfg!(feature = "bench-allocations"),
+            args.allocations,
+        );
+        println!("{line}");
+        writeln!(log, "{line}")?;
+    }
+    Ok(())
+}
