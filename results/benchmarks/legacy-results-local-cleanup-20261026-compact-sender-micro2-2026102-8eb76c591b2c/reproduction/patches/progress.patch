+        assert!(guard.progress.is_some());
+        assert_eq!(Arc::strong_count(progress), references);
+        drop(guard);
+        assert_eq!(
+            progress.snapshot().pipelines[PipelineStage::Data as usize].state,
+            PipelineState::Idle
+        );
+
+        let run = RunControl::new(None);
