     #[test]
+    fn borrowed_scopes_restore_owned_outer_scope_without_retaining_progress() {
+        let progress = ProgressHub::new().session("sender".into(), "dump", "peer");
+        let slot = &progress.pipelines[PipelineStage::Compress as usize];
+        let state = || PipelineState::from_packed(slot.load(Ordering::Relaxed));
+        let references = Arc::strong_count(&progress);
+        {
+            let _outer = progress.stage(PipelineStage::Compress, PipelineState::Compressing);
+            let references_with_outer = Arc::strong_count(&progress);
+            {
+                let _read =
+                    progress.stage_borrowed(PipelineStage::Compress, PipelineState::Reading);
+                assert_eq!(state(), PipelineState::Reading);
+                {
+                    let _wait = progress
+                        .stage_borrowed(PipelineStage::Compress, PipelineState::WaitingBuffer);
+                    assert_eq!(state(), PipelineState::WaitingBuffer);
+                    assert_eq!(Arc::strong_count(&progress), references_with_outer);
+                }
+                assert_eq!(state(), PipelineState::Reading);
+            }
+            assert_eq!(state(), PipelineState::Compressing);
+            assert_eq!(Arc::strong_count(&progress), references_with_outer);
+        }
+        assert_eq!(state(), PipelineState::Idle);
+        assert_eq!(Arc::strong_count(&progress), references);
+    }
