+// Scope заимствует уже живую session: переход состояния не требует Arc clone/drop.
+// Owned PipelineGuard остаётся для scopes, перемещающих или мутирующих владельца.
+pub(crate) struct BorrowedPipelineGuard<'a> {
+    progress: Option<&'a SessionProgress>,
+    stage: PipelineStage,
+    previous: PipelineState,
+}
+
+impl Drop for BorrowedPipelineGuard<'_> {
+    fn drop(&mut self) {
+        if let Some(progress) = self.progress {
+            let state = PipelineState::from_packed(
+                progress.pipelines[self.stage as usize].load(Ordering::Relaxed),
+            );
+            // Терминальное состояние должно пережить выход из вложенных scopes.
+            if !state.is_terminal() {
+                progress.set_stage(self.stage, self.previous);
+            }
+        }
+    }
+}
+
+pub(crate) fn stage_borrowed(
+    control: Option<&crate::runtime::SessionControl>,
+    stage: PipelineStage,
+    state: PipelineState,
+) -> BorrowedPipelineGuard<'_> {
+    match control.and_then(crate::runtime::SessionControl::progress) {
+        Some(progress) => progress.stage_borrowed(stage, state),
+        None => BorrowedPipelineGuard {
+            progress: None,
+            stage,
+            previous: PipelineState::Idle,
+        },
+    }
+}
