+    #[test]
+    fn borrowed_scopes_preserve_all_terminal_states_and_their_timestamps() {
+        for terminal in [
+            PipelineState::Done,
+            PipelineState::Failed,
+            PipelineState::Stopped,
+        ] {
+            let progress = ProgressHub::new().session("sender".into(), "dump", "peer");
+            let slot = &progress.pipelines[PipelineStage::Compress as usize];
+            let compress =
+                progress.stage_borrowed(PipelineStage::Compress, PipelineState::Compressing);
+            let reading = progress.stage_borrowed(PipelineStage::Compress, PipelineState::Reading);
+            progress.set_stage(PipelineStage::Compress, terminal);
+            let packed = slot.load(Ordering::Relaxed);
+            drop(reading);
+            drop(compress);
+            assert_eq!(slot.load(Ordering::Relaxed), packed);
+        }
+    }
+
+    #[test]
+    fn borrowed_scopes_restore_state_on_error_and_unwind() {
+        let progress = ProgressHub::new().session("sender".into(), "dump", "peer");
+        let state = || {
+            PipelineState::from_packed(
+                progress.pipelines[PipelineStage::Data as usize].load(Ordering::Relaxed),
+            )
+        };
+        let result = (|| -> Result<(), ()> {
+            let _sending = progress.stage_borrowed(PipelineStage::Data, PipelineState::Sending);
+            Err(())?;
+            Ok(())
+        })();
+        assert!(result.is_err());
+        assert_eq!(state(), PipelineState::Idle);
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _sending = progress.stage_borrowed(PipelineStage::Data, PipelineState::Sending);
+            panic!("borrowed scope unwind");
+        }));
+        assert!(result.is_err());
+        assert_eq!(state(), PipelineState::Idle);
+    }
