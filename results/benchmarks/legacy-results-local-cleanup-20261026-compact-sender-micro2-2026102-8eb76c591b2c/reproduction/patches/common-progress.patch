+//! Общий benchmark вызывает production sender scopes в обеих версиях исходников.
+
+mod observed;
+
+use std::hint::black_box;
+use std::sync::{Arc, mpsc};
+
+use anyhow::{Result, bail, ensure};
+
+use super::planner::{PlannedItem, receive_planned_item};
+use crate::progress::{PipelineStage, PipelineState, ProgressHub};
+use crate::role::Role;
+use crate::runtime::RunControl;
+use crate::sender::file_bench::{Measurement, measure_cpu_work};
+
+pub use observed::{ObservedMeasurement, measure_observed};
+
+pub fn measure_guard(case: &str, iterations: u64) -> Result<Measurement> {
+    ensure!(iterations > 0, "iterations must be positive");
+    let initial = match case {
+        "transition" | "none" => PipelineState::Idle,
+        "same-state" => PipelineState::WaitingPlan,
+        _ => bail!("unknown progress case: {case}"),
+    };
+    let run = RunControl::new(Some(Arc::new(ProgressHub::new())));
+    let session = run.session(Role::Sender, "progress-perf", "local");
+    let progress = session.progress().unwrap();
+    progress.set_stage(PipelineStage::Data, initial);
+    let references = Arc::strong_count(progress);
+    let control = (case != "none").then_some(&session);
+    let (sender, receiver) = mpsc::sync_channel(1);
+    let mut item = PlannedItem::Skips(Vec::new());
+
+    // Очередь и session созданы заранее. Один item возвращается в ту же bounded
+    // очередь; внутри интервала нет fixtures, потоков или benchmark-only guard.
+    // Измеряется реальный guard вместе с неизменным channel/cancellation путём.
+    let (item, mut measurement) = measure_cpu_work(None, || {
+        for _ in 0..iterations {
+            sender
+                .send(Ok(item))
+                .map_err(|_| anyhow::anyhow!("progress benchmark queue disconnected"))?;
+            item = black_box(receive_planned_item(
+                black_box(&receiver),
+                black_box(control),
+            )?);
+        }
+        black_box(&item);
+        Ok(item)
+    })?;
+
+    ensure!(matches!(item, PlannedItem::Skips(ref entries) if entries.is_empty()));
+    ensure!(
+        Arc::strong_count(progress) == references,
+        "guard retained progress"
+    );
+    let state = progress.snapshot().pipelines[PipelineStage::Data as usize].state;
+    ensure!(state == initial, "guard failed to restore stage");
+    measurement.fingerprint = xxhash_rust::xxh3::xxh3_64(case.as_bytes());
+    measurement.io_source = "unmeasured";
+    Ok(measurement)
+}
