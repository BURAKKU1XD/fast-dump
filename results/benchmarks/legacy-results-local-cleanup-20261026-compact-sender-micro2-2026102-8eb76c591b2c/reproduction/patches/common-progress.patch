+use fast_dump::sender::file_bench::Measurement;
+
+pub(crate) fn format(measurement: &Measurement) -> String {
+    let cycles = measurement
+        .cpu_cycles
+        .map_or_else(|| "unmeasured".to_owned(), |value| value.to_string());
+    format!(
+        "entries={} files={} bytes={} elapsed_ns={} work_ns={} drop_ns={} cpu_ns={} user_ns={} kernel_ns={} cpu_cycles={} cycle_source={} io_source={} process_peak_rss_bytes={} fingerprint={:016x} verified=true counters_schema=2 allocator_instrumented=false allocations_enabled=false",
+        measurement.entries,
+        measurement.files,
+        measurement.bytes,
+        measurement.elapsed_ns,
+        measurement.work_ns,
+        measurement.drop_ns,
+        measurement.user_ns + measurement.kernel_ns,
+        measurement.user_ns,
+        measurement.kernel_ns,
+        cycles,
+        measurement.cycle_source,
+        measurement.io_source,
+        measurement.process_peak_rss_bytes,
+        measurement.fingerprint,
+    )
+}
