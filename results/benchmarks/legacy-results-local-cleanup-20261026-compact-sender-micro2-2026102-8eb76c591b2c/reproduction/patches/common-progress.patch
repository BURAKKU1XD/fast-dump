+use std::io::Write;
+
+use anyhow::{Result, ensure};
+use clap::Parser;
+use fast_dump::sender::progress_bench::measure_guard;
+
+#[path = "support/progress_metrics.rs"]
+mod progress_metrics;
+#[path = "support/run_output.rs"]
+mod run_output;
+
+#[derive(Parser)]
+#[command(about = "Measure actual sender progress scope with its queue/cancellation path")]
+struct Args {
+    #[arg(long, value_parser = ["transition", "same-state", "none"])]
+    case: String,
+    #[arg(long, default_value_t = 1_000_000)]
+    iterations: u64,
+    #[arg(long, default_value_t = 1)]
+    repeats: usize,
+    #[arg(long = "bench", hide = true)]
+    _bench: bool,
+}
+
+fn main() -> Result<()> {
+    let args = Args::parse();
+    ensure!(
+        args.iterations > 0 && args.repeats > 0,
+        "counts must be positive"
+    );
+    let output = run_output::create_run_dir("progress-guard")?;
+    let mut log = std::fs::File::create(output.join("run.log"))?;
+    for repeat in 1..=args.repeats {
+        let measurement = measure_guard(&args.case, args.iterations)?;
+        let line = format!(
+            "[progress-perf] stage=progress-guard case={} repeat={} iterations={} scope=progress_guard_channel_process interval=iterations_only {}",
+            args.case,
+            repeat,
+            args.iterations,
+            progress_metrics::format(&measurement),
+        );
+        println!("{line}");
+        writeln!(log, "{line}")?;
+    }
+    Ok(())
+}
