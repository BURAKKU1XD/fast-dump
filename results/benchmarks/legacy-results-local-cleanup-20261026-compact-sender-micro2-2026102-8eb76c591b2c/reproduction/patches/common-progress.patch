+use std::fs::{self, File};
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, mpsc};
+use std::thread;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use anyhow::{Context, Result, bail, ensure};
+use xxhash_rust::xxh3::Xxh3Default;
+
+use crate::network::transport::{BoundListener, connect_once};
+use crate::progress::ProgressHub;
+use crate::receiver::receive_dump_profile_controlled;
+use crate::role::Role;
+use crate::runtime::RunControl;
+use crate::sender::file_bench::{Measurement, measure_cpu_work};
+use crate::sender::{BundlePlanOptions, send_dump_controlled};
+
+const DUMP_ID: &str = "observation-perf";
+
+pub struct ObservedMeasurement {
+    pub resources: Measurement,
+    pub raw_read_bytes: u64,
+    pub compressed_payload_bytes: u64,
+    pub archive_bytes: u64,
+    pub snapshots: u64,
+}
+
+struct FixtureDirectory(PathBuf);
+
+impl FixtureDirectory {
+    fn new() -> Result<Self> {
+        let root = std::env::temp_dir();
+        let stamp = SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos();
+        for sequence in 0..100 {
+            let path = root.join(format!(
+                "fast-dump-observed-perf-{}-{stamp}-{sequence}",
+                std::process::id()
+            ));
+            match fs::create_dir(&path) {
+                Ok(()) => return Ok(Self(path)),
+                Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => continue,
+                Err(error) => return Err(error).context("create observed fixture"),
+            }
+        }
+        bail!("cannot reserve observed fixture directory")
+    }
+}
+
+impl Drop for FixtureDirectory {
+    fn drop(&mut self) {
+        // Удаляем только уникальную директорию, созданную этим экземпляром.
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+struct ExpectedFile {
+    path: String,
+    bytes: Vec<u8>,
+}
+
+fn fixture(path: &Path, files: usize, bytes_per_file: usize) -> Result<Vec<ExpectedFile>> {
+    let mut state = 0x83b4_15e9_2d71_c6af_u64;
+    (0..files)
+        .map(|index| {
+            let mut bytes = vec![0; bytes_per_file];
+            for chunk in bytes.chunks_mut(8) {
+                state ^= state << 13;
+                state ^= state >> 7;
+                state ^= state << 17;
+                chunk.copy_from_slice(&state.to_le_bytes()[..chunk.len()]);
+            }
+            let file = ExpectedFile {
+                path: format!("{index:04}.bin"),
+                bytes,
+            };
+            fs::write(path.join(&file.path), &file.bytes)?;
+            Ok(file)
+        })
+        .collect()
+}
+
+fn verify_archive(path: &Path, expected: &[ExpectedFile]) -> Result<u64> {
+    let decoder = zstd::stream::read::Decoder::new(File::open(path)?)?;
+    let mut archive = tar::Archive::new(decoder);
+    let mut fingerprint = Xxh3Default::new();
+    let mut count = 0;
+    for entry in archive.entries()? {
+        let mut entry = entry?;
+        let expected = expected.get(count).context("unexpected archive entry")?;
+        ensure!(
+            entry.path()?.as_ref() == Path::new(&expected.path),
+            "archive path mismatch"
+        );
+        ensure!(
+            entry.header().entry_type().is_file(),
+            "archive type mismatch"
+        );
+        ensure!(entry.link_name()?.is_none(), "unexpected archive link");
+        ensure!(
+            entry.size() == expected.bytes.len() as u64,
+            "archive size mismatch"
+        );
+        let mut actual = Vec::new();
+        entry.read_to_end(&mut actual)?;
+        ensure!(
+            actual == expected.bytes,
+            "archive payload mismatch: {}",
+            expected.path
+        );
+        fingerprint.update(&(expected.path.len() as u64).to_le_bytes());
+        fingerprint.update(expected.path.as_bytes());
+        fingerprint.update(&(actual.len() as u64).to_le_bytes());
+        fingerprint.update(&actual);
+        count += 1;
+    }
+    ensure!(count == expected.len(), "archive entry count mismatch");
+    // Дочитывание всех frames проверяет footer zstd и второй нулевой блок tar.
+    let mut decoder = archive.into_inner();
+    let mut tail = [0_u8; 8192];
+    let mut tail_bytes = 0;
+    loop {
+        let count = decoder.read(&mut tail)?;
+        if count == 0 {
+            break;
+        }
+        ensure!(
+            tail[..count].iter().all(|byte| *byte == 0),
+            "nonzero archive tail"
+        );
+        tail_bytes += count;
+    }
+    ensure!(tail_bytes >= 512, "missing final tar zero block");
+    Ok(fingerprint.digest())
+}
+
+pub fn measure_observed(case: &str) -> Result<ObservedMeasurement> {
+    let (files, bytes_per_file) = match case {
+        "many-small" => (2_000, 4 * 1024),
+        "streamed-large" => (1, 64 * 1024 * 1024),
+        _ => bail!("unknown observed fixture: {case}"),
+    };
+    let source = FixtureDirectory::new()?;
+    let output = FixtureDirectory::new()?;
+    let expected = fixture(&source.0, files, bytes_per_file)?;
+    let hub = Arc::new(ProgressHub::new());
+    let run = RunControl::new(Some(Arc::clone(&hub)));
+    let sender = run.session(Role::Sender, DUMP_ID, "loopback");
+    let receiver = run.session(Role::Receiver, DUMP_ID, "loopback");
+    let listener = BoundListener::bind("127.0.0.1:0".parse()?)?;
+    let address = listener.local_addr();
+    let output_path = output.0.clone();
+    let source_path = source.0.clone();
+
+    // Fixture, транспорт, запуск потоков, verification и join observer находятся
+    // вне интервала. CPU включает sender, receiver и снимки observer без render.
+    let ((sent, received), mut resources, snapshots) = thread::scope(|scope| -> Result<_> {
+        let (receiver_ready, receive_ready) = mpsc::sync_channel(0);
+        let (begin, beginning) = mpsc::sync_channel(0);
+        let receive_worker = scope.spawn(move || -> Result<_> {
+            let session = listener.accept(Role::Receiver, None, None)?;
+            let _control = receiver.register(&session.control_stream)?;
+            let _data = receiver.register(&session.data_stream)?;
+            receiver_ready.send(())?;
+            beginning.recv()?;
+            receive_dump_profile_controlled(
+                session.control_stream,
+                session.data_stream,
+                output_path,
+                DUMP_ID,
+                &receiver,
+            )
+        });
+        let mut session = connect_once(Role::Sender, address, Some(DUMP_ID), None)?;
+        let _control = sender.register(&session.control_stream)?;
+        let _data = sender.register(&session.data_stream)?;
+        receive_ready.recv()?;
+        let (stop, stopping) = mpsc::channel::<()>();
+        let (ready, started) = mpsc::sync_channel(0);
+        let (start_observer, observe_started) = mpsc::sync_channel(0);
+        hub.log(log::Level::Info, "Performance sample started");
+        let observer_hub = &hub;
+        let observer = scope.spawn(move || {
+            let _ = ready.send(());
+            if observe_started.recv().is_err() {
+                return 0;
+            }
+            let mut snapshots = 0;
+            loop {
+                for session in observer_hub.sessions() {
+                    std::hint::black_box(session.snapshot());
+                }
+                std::hint::black_box(observer_hub.logs());
+                snapshots += 1;
+                if snapshots == 1 {
+                    let _ = ready.send(());
+                }
+                match stopping.recv_timeout(Duration::from_millis(200)) {
+                    Err(mpsc::RecvTimeoutError::Timeout) => {}
+                    Ok(()) | Err(mpsc::RecvTimeoutError::Disconnected) => return snapshots,
+                }
+            }
+        });
+        started.recv()?;
+        let measured = measure_cpu_work(None, || {
+            start_observer.send(())?;
+            // Первый снимок входит в измерение даже для transfer короче 200 ms.
+            started.recv()?;
+            begin.send(())?;
+            let sent = send_dump_controlled(
+                &mut session.control_stream,
+                &mut session.data_stream,
+                source_path,
+                DUMP_ID,
+                BundlePlanOptions {
+                    bundle_target_bytes: 8 * 1024 * 1024,
+                    compression_level: 3,
+                    compression_threads: 1,
+                    readers: 4,
+                },
+                &sender,
+            );
+            if sent.is_err() {
+                run.cancel();
+            }
+            let received = receive_worker
+                .join()
+                .map_err(|_| anyhow::anyhow!("observed receiver panicked"))?;
+            Ok((sent?, received?))
+        });
+        if measured.is_err() {
+            run.cancel();
+        }
+        drop(start_observer);
+        drop(begin);
+        drop(stop);
+        let snapshots = observer
+            .join()
+            .map_err(|_| anyhow::anyhow!("observer panicked"))?;
+        let (result, resources) = measured?;
+        ensure!(snapshots > 0, "observer did not run");
+        Ok((result, resources, snapshots))
+    })?;
+
+    let (sent, profile) = sent;
+    let (received, receiver_profile) = received;
+    ensure!(
+        sent.terminal_skip_count == 0 && profile.terminal_skips == 0,
+        "unexpected skips"
+    );
+    ensure!(
+        profile.bundle_aborts == 0 && profile.bundle_rebuilds == 0,
+        "unexpected retries"
+    );
+    ensure!(
+        profile.bundled_entries == files as u64,
+        "sender entry count mismatch"
+    );
+    let snapshot = sender.progress().unwrap().snapshot();
+    ensure!(snapshot.committed_entries == files as u64 && snapshot.scan_finished);
+    resources.entries = files as u64;
+    resources.files = files as u64;
+    resources.bytes = (files * bytes_per_file) as u64;
+    resources.fingerprint = verify_archive(&received.final_archive_path, &expected)?;
+    resources.io_source = "unmeasured";
+    Ok(ObservedMeasurement {
+        resources,
+        raw_read_bytes: profile.read.bytes,
+        compressed_payload_bytes: receiver_profile.bundle_write.bytes,
+        archive_bytes: fs::metadata(received.final_archive_path)?.len(),
+        snapshots,
+    })
+}
