+
+#[path = "support/progress_metrics.rs"]
+mod progress_metrics;
+#[path = "support/run_output.rs"]
+mod run_output;
+
+#[derive(Parser)]
+#[command(
+    about = "Measure observed transfer with real progress snapshots and archive verification"
+)]
+struct Args {
+    #[arg(long, value_parser = ["many-small", "streamed-large"])]
+    fixture: String,
+    #[arg(long, default_value_t = 1)]
+    repeats: usize,
+    #[arg(long = "bench", hide = true)]
+    _bench: bool,
+}
+
+fn main() -> Result<()> {
+    let args = Args::parse();
+    ensure!(args.repeats > 0, "repeats must be positive");
+    let output = run_output::create_run_dir("observed-e2e")?;
+    let mut log = std::fs::File::create(output.join("run.log"))?;
+    for repeat in 1..=args.repeats {
+        let measurement = measure_observed(&args.fixture)?;
+        let line = format!(
+            "[observed-e2e-perf] stage=observed-e2e case={} repeat={} iterations=1 scope=sender_receiver_observer_process interval=transfer_and_first_snapshot readers=4 threads=1 level=3 frame_mib=8 observer_hz=5 raw_read_bytes={} compressed_payload_bytes={} archive_bytes={} skipped_files=0 frame_aborts=0 frame_rebuilds=0 total_terminal_skips=0 observer_snapshots={} {}",
+            args.fixture,
+            repeat,
+            measurement.raw_read_bytes,
+            measurement.compressed_payload_bytes,
+            measurement.archive_bytes,
+            measurement.snapshots,
+            progress_metrics::format(&measurement.resources),
+        );
+        println!("{line}");
+        writeln!(log, "{line}")?;
+    }
+    Ok(())
+}
