+pub(crate) fn measure_cpu_work<T>(
+    hooks: Option<AllocationHooks>,
+    work: impl FnOnce() -> Result<T>,
+) -> Result<(T, Measurement)> {
+    // Микробенч control использует те же OS snapshots, но не включает подготовку
+    // и освобождение fixture. Счётчики I/O этой обёрткой не публикуются.
+    let (result, interval) = timed(hooks, work)?;
+    let measurement = Measurement {
+        elapsed_ns: interval.wall_ns,
+        work_ns: interval.wall_ns,
+        user_ns: interval
+            .after
+            .user_ns
+            .saturating_sub(interval.before.user_ns),
+        kernel_ns: interval
+            .after
+            .kernel_ns
+            .saturating_sub(interval.before.kernel_ns),
+        cpu_cycles: interval
+            .after
+            .cpu_cycles
+            .zip(interval.before.cpu_cycles)
+            .and_then(|(after, before)| after.checked_sub(before)),
+        cycle_source: if cfg!(windows) {
+            "windows-process-cycle-time"
+        } else {
+            "unavailable"
+        },
+        process_peak_rss_bytes: interval.after.peak_rss_bytes,
+        allocations: interval.allocations,
+        ..Measurement::default()
+    };
+    Ok((result, measurement))
 }
 
