@@ -0,0 +1,234 @@
+//! Production planner: создание с resume-каталогом и регистрация terminal skips.
+
+use std::fs;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use anyhow::{Context, Result, ensure};
+use xxhash_rust::xxh3::Xxh3Default;
+
+use super::{BundlePlanOptions, DumpPlanner};
+use crate::network::protocol::{ResumeState, SkipReason, SkippedEntry};
+use crate::sender::file_bench::{AllocationHooks, Measurement, measure_cpu_work};
+
+pub const CASES: [&str; 4] = ["resume-0", "resume-4096", "new-unique", "new-duplicate"];
+
+pub struct PlannerMeasurement {
+    pub counters: Measurement,
+    pub entries: u64,
+    pub bytes: u64,
+    pub constructors: u64,
+    pub records: u64,
+    pub terminal_skips: u64,
+    pub outgoing_skips: u64,
+    pub fingerprint: u64,
+}
+
+struct EmptySource(PathBuf);
+
+impl EmptySource {
+    fn new() -> Result<Self> {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let path = std::env::temp_dir().join(format!(
+            "fast-dump-planner-bench-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed),
+        ));
+        fs::create_dir(&path)
+            .with_context(|| format!("create benchmark source {}", path.display()))?;
+        Ok(Self(path))
+    }
+}
+
+impl Drop for EmptySource {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir(&self.0);
+    }
+}
+
+fn entry(index: usize) -> SkippedEntry {
+    SkippedEntry {
+        work_ordinal: index as u64 + 1,
+        relative_path: format!("каталог/🙂/entry-{index:08}"),
+        reason: match index % 4 {
+            0 => SkipReason::OpenFailed,
+            1 => SkipReason::UnstableAfterRetries,
+            2 => SkipReason::ReadSymlinkFailed,
+            _ => SkipReason::UnsupportedEntry,
+        },
+    }
+}
+
+fn hash_entry(hash: &mut Xxh3Default, entry: &SkippedEntry) {
+    hash.update(&entry.work_ordinal.to_le_bytes());
+    hash.update(&(entry.relative_path.len() as u64).to_le_bytes());
+    hash.update(entry.relative_path.as_bytes());
+    hash.update(entry.reason.as_str().as_bytes());
+}
+
+fn options() -> BundlePlanOptions {
+    BundlePlanOptions {
+        readers: 1,
+        ..BundlePlanOptions::default()
+    }
+}
+
+pub fn measure(
+    case: &str,
+    iterations: u64,
+    hooks: Option<AllocationHooks>,
+) -> Result<PlannerMeasurement> {
+    ensure!(
+        CASES.contains(&case),
+        "unknown planner benchmark case: {case}"
+    );
+    ensure!(iterations > 0, "iterations must be positive");
+    let source = EmptySource::new()?;
+    let mut fingerprint = Xxh3Default::new();
+    fingerprint.update(case.as_bytes());
+    fingerprint.update(&iterations.to_le_bytes());
+
+    if case.starts_with("resume-") {
+        let count = if case == "resume-4096" { 4096 } else { 0 };
+        let state = ResumeState {
+            terminal_skips: (0..count).map(entry).collect(),
+            ..ResumeState::default()
+        };
+        let entries = iterations
+            .checked_mul(count as u64)
+            .context("entry count overflow")?;
+        let path_bytes: u64 = state
+            .terminal_skips
+            .iter()
+            .map(|entry| entry.relative_path.len() as u64)
+            .sum();
+        let bytes = iterations
+            .checked_mul(path_bytes)
+            .context("path byte count overflow")?;
+        for entry in &state.terminal_skips {
+            hash_entry(&mut fingerprint, entry);
+        }
+        let options = options();
+        // Полный конструктор, его clones, finish_profile и Drop/join находятся внутри таймера.
+        let ((terminal_skips, outgoing_skips, discovered), counters) =
+            measure_cpu_work(hooks, || {
+                let mut terminal = 0;
+                let mut outgoing = 0;
+                let mut discovered = 0;
+                for _ in 0..iterations {
+                    let mut planner = DumpPlanner::new(&source.0, &state, options)?;
+                    outgoing += planner.take_new_terminal_skips().len() as u64;
+                    let profile = planner.finish_profile();
+                    terminal += profile.terminal_skips;
+                    discovered += profile.discovered_entries;
+                }
+                Ok((terminal, outgoing, discovered))
+            })?;
+        ensure!(terminal_skips == entries, "resume terminal count differs");
+        ensure!(outgoing_skips == 0, "saved skips were queued again");
+        ensure!(discovered == 0, "empty source discovered entries");
+        return Ok(PlannerMeasurement {
+            counters,
+            entries,
+            bytes,
+            constructors: iterations,
+            records: 0,
+            terminal_skips,
+            outgoing_skips,
+            fingerprint: fingerprint.digest(),
+        });
+    }
+
+    let duplicate = case == "new-duplicate";
+    let count = usize::try_from(iterations).context("iteration count exceeds address space")?;
+    let state = ResumeState {
+        terminal_skips: if duplicate {
+            vec![entry(0)]
+        } else {
+            Vec::new()
+        },
+        ..ResumeState::default()
+    };
+    let mut planner = DumpPlanner::new(&source.0, &state, options())?;
+    ensure!(
+        planner.take_new_terminal_skips().is_empty(),
+        "unexpected initial outgoing skips"
+    );
+    let inputs: Vec<_> = (0..count)
+        .map(|index| entry(if duplicate { 0 } else { index }))
+        .collect();
+    let bytes = inputs
+        .iter()
+        .map(|entry| entry.relative_path.len() as u64)
+        .sum();
+    for input in &inputs {
+        hash_entry(&mut fingerprint, input);
+    }
+    let expected = if duplicate {
+        Vec::new()
+    } else {
+        inputs.clone()
+    };
+    // Входные строки подготовлены заранее. Измеряем production record, выгрузку очереди
+    // и уничтожение planner; возвращённые descriptors проверяем и освобождаем после таймера.
+    let ((outgoing, profile), counters) = measure_cpu_work(hooks, || {
+        for skipped in inputs {
+            planner.record_terminal_skip(skipped);
+        }
+        let outgoing = planner.take_new_terminal_skips();
+        Ok((outgoing, planner.finish_profile()))
+    })?;
+    ensure!(
+        outgoing == expected,
+        "outgoing skip descriptors/order differ"
+    );
+    let expected_terminal = if duplicate { 1 } else { iterations };
+    ensure!(
+        profile.terminal_skips == expected_terminal,
+        "new skip terminal count differs"
+    );
+    ensure!(
+        profile.discovered_entries == 0,
+        "empty source discovered entries"
+    );
+    Ok(PlannerMeasurement {
+        counters,
+        entries: iterations,
+        bytes,
+        constructors: 0,
+        records: iterations,
+        terminal_skips: profile.terminal_skips,
+        outgoing_skips: outgoing.len() as u64,
+        fingerprint: fingerprint.digest(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn planner_benchmark_verifies_resume_and_unique_duplicate_outputs() {
+        for case in CASES {
+            let measured = measure(case, 3, None).unwrap();
+            match case {
+                "resume-0" => {
+                    assert_eq!((measured.terminal_skips, measured.outgoing_skips), (0, 0))
+                }
+                "resume-4096" => assert_eq!(
+                    (measured.terminal_skips, measured.outgoing_skips),
+                    (3 * 4096, 0)
+                ),
+                "new-unique" => {
+                    assert_eq!((measured.terminal_skips, measured.outgoing_skips), (3, 3))
+                }
+                "new-duplicate" => {
+                    assert_eq!((measured.terminal_skips, measured.outgoing_skips), (1, 0))
+                }
+                _ => unreachable!(),
+            }
+        }
+        assert!(measure("invalid", 1, None).is_err());
+        assert!(measure("resume-0", 0, None).is_err());
+    }
+}
